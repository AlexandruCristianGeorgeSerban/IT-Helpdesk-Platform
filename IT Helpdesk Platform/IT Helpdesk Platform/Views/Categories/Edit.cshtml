@model IT_Helpdesk_Platform.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container main-container mt-4">
    <h2 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Edit Category #@Model.Id</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="content-card shadow-sm p-4 bg-white rounded">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Category Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between border-top pt-3">
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}