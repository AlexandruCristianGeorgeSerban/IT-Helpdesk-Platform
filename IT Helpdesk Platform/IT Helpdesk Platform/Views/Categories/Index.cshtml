@model IEnumerable<IT_Helpdesk_Platform.Models.Category>

@{
    ViewData["Title"] = "Ticket Categories";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-tags me-2"></i>Ticket Categories</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-tags-fill me-1"></i> Add New Category</a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex align-items-center">
                <i class="bi bi-search fs-5 text-muted me-3"></i>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 shadow-none" placeholder="Search categories by ID or Name..." />
                <button type="submit" class="btn btn-primary ms-3 rounded-pill px-4">Search</button>
                @if (ViewData["CurrentFilter"] != null)
                {
                    <a asp-action="Index" class="btn btn-light ms-2 rounded-pill px-4">Clear</a>
                }
            </form>
        </div>
    </div>

    <div class="content-card table-shadow p-4 bg-white rounded">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 10%;">ID</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@item.Id</td>
                        <td class="fw-bold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success shadow-sm" title="Details">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted mb-0">No categories found matching your search.</p>
            </div>
        }
    </div>
</div>

<partial name="_BackToTop" />