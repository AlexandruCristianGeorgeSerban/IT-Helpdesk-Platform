@{
    ViewData["Title"] = "Administrator Dashboard";
}

<div class="container main-container mt-4">
    <div class="text-center mb-5 pb-3 border-bottom">
        <h1 class="display-5 fw-bold text-danger"><i class="bi bi-headset me-2"></i>IT Administrator Platform</h1>
        <p class="lead text-muted">Welcome to the IT Support management system. Choose a module below to get started.</p>
    </div>

    <div class="row g-4 justify-content-center">
        
        <div class="col-md-6 col-lg-3">
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-none">
                <div class="stat-card card h-100 text-center p-4 border-0 bg-white" style="border-top: 4px solid #0d6efd !important;">
                    <i class="bi bi-ticket-detailed display-4 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-1">Tickets</h5>
                    <p class="text-muted small mb-0">Manage support requests</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a asp-controller="Users" asp-action="Index" class="text-decoration-none">
                <div class="stat-card card h-100 text-center p-4 border-0 bg-white" style="border-top: 4px solid #198754 !important;">
                    <i class="bi bi-people display-4 text-success mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-1">Users</h5>
                    <p class="text-muted small mb-0">Manage staff & agents</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a asp-controller="Departments" asp-action="Index" class="text-decoration-none">
                <div class="stat-card card h-100 text-center p-4 border-0 bg-white" style="border-top: 4px solid #ffc107 !important;">
                    <i class="bi bi-building display-4 text-warning mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-1">Departments</h5>
                    <p class="text-muted small mb-0">Company structure</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a asp-controller="Categories" asp-action="Index" class="text-decoration-none">
                <div class="stat-card card h-100 text-center p-4 border-0 bg-white" style="border-top: 4px solid #dc3545 !important;">
                    <i class="bi bi-tags display-4 text-danger mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-1">Categories</h5>
                    <p class="text-muted small mb-0">Issue classifications</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-3">
            <a asp-controller="KnowledgeArticles" asp-action="Index" class="text-decoration-none">
                <div class="stat-card card h-100 text-center p-4 border-0 bg-white" style="border-top: 4px solid #0dcaf0 !important;">
                    <i class="bi bi-journals display-4 text-info mb-3"></i>
                    <h5 class="card-title fw-bold text-dark mb-1">Articles</h5>
                    <p class="text-muted small mb-0">Manage Knowledge Base</p>
                </div>
            </a>
        </div>

    </div>
</div>