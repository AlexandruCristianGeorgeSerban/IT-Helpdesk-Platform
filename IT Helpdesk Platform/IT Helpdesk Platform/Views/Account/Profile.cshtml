@model IT_Helpdesk_Platform.Models.User

@{
    ViewData["Title"] = "My Profile";

    string roleDisplayName = Model.Role switch
    {
        "Admin" => "Administrator",
        "Agent" => "IT Agent",
        _ => "User"
    };

    string roleBadgeClass = Model.Role switch
    {
        "Admin" => "bg-danger",
        "Agent" => "bg-success",
        _ => "bg-primary"
    };

    bool isITStaff = Model.Role == "Admin" || Model.Role == "Agent";
    
    int activeTicketsCount = 0;
    int completedTicketsCount = 0;

    if (isITStaff)
    {
        activeTicketsCount = Model.AssignedTickets?.Count(t => t.Status == "Open" || t.Status == "In Progress") ?? 0;
        completedTicketsCount = Model.AssignedTickets?.Count(t => t.Status == "Resolved" || t.Status == "Closed") ?? 0;
    }
    else
    {
        activeTicketsCount = Model.SubmittedTickets?.Count(t => t.Status == "Open" || t.Status == "In Progress") ?? 0;
        completedTicketsCount = Model.SubmittedTickets?.Count(t => t.Status == "Resolved" || t.Status == "Closed") ?? 0;
    }

    bool hasProfilePic = false;
    if (!string.IsNullOrEmpty(Model.ProfilePicturePath))
    {
        var physicalPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", Model.ProfilePicturePath.TrimStart('/'));
        if (System.IO.File.Exists(physicalPath))
        {
            hasProfilePic = true;
        }
    }
    var profilePicUrl = hasProfilePic ? Model.ProfilePicturePath : Url.Content("~/images/person-circle.svg");
}

<style>
    .avatar-wrapper {
        position: relative;
        width: 120px;
        height: 120px;
        margin: 0 auto;
        border-radius: 50%;
        overflow: hidden;
        background-color: var(--bs-secondary-bg);
        border: 2px solid var(--bs-border-color);
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .avatar-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

        .avatar-image.default-svg {
            filter: brightness(0) invert(0.6);
            padding: 10px;
        }

    .avatar-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.65);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        opacity: 0;
        transition: opacity 0.3s ease;
        cursor: pointer;
    }

    .avatar-wrapper:hover .avatar-overlay {
        opacity: 1;
    }
    
    .form-control[readonly] {
        background-color: var(--bs-tertiary-bg);
        opacity: 1;
    }
</style>

<div class="container main-container mt-4">
    <h2 class="mb-4 text-body"><i class="bi bi-person text-secondary me-2"></i>My Profile</h2>

    <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data" id="profileForm">
        <input type="hidden" name="Id" value="@Model.Id" />
        
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="content-card text-center h-100 p-4 shadow-sm bg-white rounded">
                    
                    <div class="avatar-wrapper mb-3" onclick="document.getElementById('profilePicInput').click()">
                        <img src="@profilePicUrl" id="avatarPreview" class="avatar-image @(!hasProfilePic ? "default-svg" : "")" alt="Profile Picture" />
                        
                        <div class="avatar-overlay">
                            <i class="bi bi-camera-fill fs-4"></i>
                            <span class="small mt-1 fw-bold">Change</span>
                        </div>
                    </div>
                    
                    <input type="file" id="profilePicInput" name="ProfilePicture" accept="image/*" class="d-none" onchange="previewImage(this)">

                    <h4 class="mb-1 text-body">@Model.FirstName @Model.LastName</h4>
                    <p class="text-body-secondary mb-3">
                        <span class="badge @roleBadgeClass me-1">@roleDisplayName</span>
                        @(Model.Department != null ? Model.Department.Name : "No Department")
                    </p>

                    <div class="badge bg-success w-100 mb-4 py-2 shadow-sm fs-6">Active Account</div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-body-secondary">@(isITStaff ? "Assigned Tickets" : "Open Tickets")</span>
                        <span class="badge bg-primary rounded-pill">@activeTicketsCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="text-body-secondary">Resolved Tickets</span>
                        <span class="badge bg-secondary rounded-pill">@completedTicketsCount</span>
                    </div>

                    <hr class="border-secondary-subtle" />
                </div>
            </div>

            <div class="col-md-8 mb-4">
                <div class="content-card h-100 p-4 shadow-sm bg-white rounded">
                    <h4 class="mb-4 text-body"><i class="bi bi-gear me-2"></i>Account Settings</h4>

                    @if (TempData["ProfileSuccess"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["ProfileSuccess"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-body-secondary small fw-bold">FIRST NAME</label>
                            <input type="text" name="FirstName" class="form-control" value="@Model.FirstName" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-body-secondary small fw-bold">LAST NAME</label>
                            <input type="text" name="LastName" class="form-control" value="@Model.LastName" required>
                        </div>
                    </div>

                    <div class="mb-3 mt-2">
                        <label class="form-label text-body-secondary small fw-bold">EMAIL ADDRESS</label>
                        <input type="email" class="form-control" value="@Model.Email" readonly>
                        <div class="form-text text-body-secondary mt-2">Your email address is managed by the IT administrator and cannot be changed.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-body-secondary small fw-bold">PHONE NUMBER</label>
                        <div class="input-group shadow-sm">
                            <select class="form-select bg-light text-body-secondary border-secondary-subtle" id="countryCode" style="max-width: 130px;" onchange="updateHiddenPhone()">
                                <option value="+1">🇺🇸/🇨🇦 +1</option>
                                <option value="+40" selected>🇷🇴 +40</option>
                                <option value="+44">🇬🇧 +44</option>
                            </select>
                            
                            <input type="text" id="phoneDigits" class="form-control border-secondary-subtle" placeholder="777 123 456" oninput="this.value = this.value.replace(/[^0-9 ]/g, ''); updateHiddenPhone()">
                            
                            <input type="hidden" name="PhoneNumber" id="fullPhoneNumber" value="@Model.PhoneNumber">
                        </div>
                    </div>

                    <hr class="my-4 border-secondary-subtle">

                    <h5 class="mb-3 text-body">Notification Preferences</h5>
                    
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="EmailNotificationsEnabled">
                        <label class="form-check-label text-body" asp-for="EmailNotificationsEnabled">Email me when a ticket status changes</label>
                    </div>
                    
                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="PushNotificationsEnabled">
                        <label class="form-check-label text-body" asp-for="PushNotificationsEnabled">Enable desktop push notifications</label>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 shadow-sm mt-3">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                
                reader.onload = function(e) {
                    var img = document.getElementById('avatarPreview');
                    img.src = e.target.result;
                    img.classList.remove('default-svg');
                }
                
                reader.readAsDataURL(input.files[0]);
            }
        }

        $(document).ready(function () {
            var fullPhone = $('#fullPhoneNumber').val();
            if (fullPhone) {
                var parts = fullPhone.split(' ');
                if (parts.length > 1) {
                    $('#countryCode').val(parts[0]);
                    $('#phoneDigits').val(parts.slice(1).join(' '));
                } else {
                    $('#phoneDigits').val(fullPhone);
                }
            }
        });

        function updateHiddenPhone() {
            var code = document.getElementById('countryCode').value;
            var digits = document.getElementById('phoneDigits').value;
            document.getElementById('fullPhoneNumber').value = code + ' ' + digits;
        }
    </script>
}