                    </div>

                    <hr class="my-4 border-secondary-subtle">

                    <h5 class="mb-3 text-body">Notification Preferences</h5>
                    
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="EmailNotificationsEnabled">
