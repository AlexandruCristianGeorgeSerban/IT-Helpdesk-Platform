@model IT_Helpdesk_Platform.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthentificationLayout";
}

<div class="login-container flex-grow-1 d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-4">
                
                <div class="content-card text-center p-4 shadow-sm bg-white rounded">
                    
                    <div class="mb-4">
                        <h2 class="text-primary fw-bold">
                            <i class="bi bi-headset"></i> IT Helpdesk
                        </h2>
                        <p class="text-muted">Sign in to your account</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" method="post" class="text-start">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted small text-uppercase fw-bold">Email Address</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="name@company.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="mb-2">
                            <label asp-for="Password" class="form-label text-muted small text-uppercase fw-bold">Password</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="Password" class="form-control border-start-0 border-end-0" placeholder="••••••••" id="password" />
                                <span class="input-group-text bg-white border-start-0 password-toggle-icon" onclick="togglePassword('password', 'eyeIconLogin')" style="cursor:pointer;">
                                    <i class="bi bi-eye text-muted" id="eyeIconLogin"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check mb-0 text-start">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted">
                                    Remember me
                                </label>
                            </div>
                            <a href="#" class="small text-decoration-none" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">Forgot Password?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 mb-3 shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                        </button>
                    </form>

                    <div class="border-top pt-3 mt-3">
                        <p class="text-muted small mb-0">
                            Don't have an account?
                            <a href="#" class="text-decoration-none fw-bold" data-bs-toggle="modal" data-bs-target="#registerModal">Create one now</a>
                        </p>
                    </div>

                </div>
                
                <div class="text-center mt-4">
                    <p class="text-muted small">&copy; 2026 Internal IT Support. All rights reserved.</p>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="registerModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="registerModalLabel"><i class="bi bi-person-plus me-2"></i>Create New Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <form id="registerForm">
                    <div id="registerError" class="alert alert-danger d-none small"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">First Name</label>
                            <input type="text" name="FirstName" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Last Name</label>
                            <input type="text" name="LastName" class="form-control" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Department</label>
                        <select name="DepartmentId" class="form-select" asp-items="ViewBag.Departments" required>
                            <option selected disabled value="">Choose Department...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Email</label>
                        <input type="email" name="Email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Choose Password</label>
                        <div class="input-group">
                            <input type="password" name="Password" class="form-control border-end-0" id="regPassword" required>
                            <span class="input-group-text bg-white border-start-0 password-toggle-icon" onclick="togglePassword('regPassword', 'eyeIconReg1')" style="cursor:pointer;">
                                <i class="bi bi-eye text-muted" id="eyeIconReg1"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Confirm Password</label>
                        <div class="input-group">
                            <input type="password" name="ConfirmPassword" class="form-control border-end-0" id="regConfirmPassword" required>
                            <span class="input-group-text bg-white border-start-0 password-toggle-icon" onclick="togglePassword('regConfirmPassword', 'eyeIconReg2')" style="cursor:pointer;">
                                <i class="bi bi-eye text-muted" id="eyeIconReg2"></i>
                            </span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="btnRegister">Register & Login</button>
                </form>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="forgotPasswordModal" data-bs-backdrop="static" tabindex="-1" aria-labelledby="forgotPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="forgotPasswordModalLabel"><i class="bi bi-key me-2"></i>Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                
                <div id="forgotPasswordFormContainer">
                    <p class="text-muted small mb-4 text-start">Enter your email address below and we'll send you a secure link to reset your password.</p>
                    
                    <form id="forgotPasswordForm" class="text-start">
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold text-uppercase">Email Address</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" name="Email" class="form-control border-start-0" placeholder="name@company.com" required id="forgotEmailInput">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 shadow-sm" id="btnForgot">
                            <i class="bi bi-send me-1"></i> Send Reset Link
                        </button>
                    </form>
                </div>

                <div id="maintenanceMessageContainer" class="d-none">
                    <div class="mb-4 mt-2">
                        <i class="bi bi-tools text-warning" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-3">System Under Maintenance</h5>
                    <p class="text-muted small mb-4">
                        We are currently migrating our internal SMTP email services. Automated password resets are temporarily disabled. Please contact the IT Administration team directly to verify your identity and regain access.
                    </p>
                    
                    <a href="mailto:admin@helpdesk.com" class="btn btn-primary w-100 shadow-sm mb-2">
                        <i class="bi bi-envelope me-2"></i> Contact IT Support
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // --- PASSWORD VISIBILITY TOGGLE ---
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = "password";
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        $(document).ready(function () {
            
            // --- AJAX FOR REGISTER ---
            $('#registerForm').on('submit', function (e) {
                e.preventDefault();

                var password = $('#regPassword').val();
                var confirmPassword = $('#regConfirmPassword').val();
                var $errorDiv = $('#registerError');

                // Reset error state
                $errorDiv.addClass('d-none').removeClass('alert-success').addClass('alert-danger');

                // Client-side validation for matching passwords
                if (password !== confirmPassword) {
                    $errorDiv.removeClass('d-none').text('Passwords do not match! Please try again.');
                    return false;
                }

                var $btn = $('#btnRegister');
                var formData = $(this).serialize();

                // Show loading state
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Processing...');

                $.ajax({
                    type: 'POST',
                    url: '/Account/RegisterAjax',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            // 1. Hide all form inputs to make room for the success message
                            $('#registerForm .row, #registerForm .mb-3, #registerForm .mb-4').slideUp();
                            
                            // 2. Display a prominent and styled success message
                            $errorDiv.removeClass('alert-danger d-none alert-sm')
                                    .addClass('alert-success text-center p-4 fs-5')
                                    .html('<i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i><br><br>Account created successfully!<br><small class="text-muted fs-6">Please verify your account to proceed.</small>');
    
                            // 3. Transform the Register button into a Verification button
                            $btn.prop('disabled', false)
                                .removeClass('btn-primary').addClass('btn-warning btn-lg mt-3')
                                .html('Verify Account Now <i class="bi bi-shield-check ms-2"></i>')
                                // Unbind previous "submit" events and add the verification logic
                                .off('click').on('click', function(e) {
                                    e.preventDefault();
                                    verifyAccountSimulated(response.email, response.redirectUrl, $btn, $errorDiv);
                                });

                        } else {
                            // Display backend errors (e.g. duplicate email)
                            $errorDiv.removeClass('d-none').text(response.message);
                            $btn.prop('disabled', false).text('Register & Login');
                        }
                    },
                    error: function () {
                        // Handle server connection issues
                        $errorDiv.removeClass('d-none').text('Server error. Could not process your request.');
                        $btn.prop('disabled', false).text('Register & Login');
                    }
                });
            });

            // --- TRICK FOR FORGOT PASSWORD (Simulated Maintenance) ---
            $('#forgotPasswordForm').on('submit', function (e) {
                e.preventDefault(); // Stop the actual form submission
                var $btn = $('#btnForgot');

                // Simulate that the system is trying to connect to the email server
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Connecting to SMTP Server...');

                // Wait 1.5 seconds for effect, then show the maintenance error
                setTimeout(function() {
                    $('#forgotPasswordFormContainer').hide(); // Hide the original form
                    $('#maintenanceMessageContainer').removeClass('d-none').hide().fadeIn('slow'); // Elegantly display the maintenance message
                }, 1500);
            });

            // Extra trick: Reset the modal to its initial state if the user closes and reopens it
            $('#forgotPasswordModal').on('hidden.bs.modal', function () {
                $('#forgotPasswordFormContainer').show();
                $('#maintenanceMessageContainer').addClass('d-none');
                $('#forgotPasswordForm')[0].reset();
                $('#btnForgot').prop('disabled', false).html('<i class="bi bi-send me-1"></i> Send Reset Link');
            });
            
        });
    </script>
}