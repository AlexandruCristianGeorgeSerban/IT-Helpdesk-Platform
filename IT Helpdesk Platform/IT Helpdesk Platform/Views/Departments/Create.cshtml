@model IT_Helpdesk_Platform.Models.Department

@{
    ViewData["Title"] = "Create Department";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <h2 class="mb-4"><i class="bi bi-building-add me-2"></i>Create New Department</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="content-card shadow-sm p-4 bg-white rounded">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold">Department Name</label>
                        <input asp-for="Name" class="form-control" placeholder="E.g., HR, IT, Finance..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between border-top pt-3">
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Create Department
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}