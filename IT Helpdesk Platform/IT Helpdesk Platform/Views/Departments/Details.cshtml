@model IT_Helpdesk_Platform.Models.Department

@{
    ViewData["Title"] = "Department Details";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <h2 class="mb-4"><i class="bi bi-info-circle me-2"></i>Department #@Model.Id</h2>
    
    <div class="content-card shadow-sm p-4 bg-white rounded" style="max-width: 600px;">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Department Name</dt>
            <dd class="col-sm-8 fs-5">@Model.Name</dd>
        </dl>
        
        <div class="d-flex justify-content-between border-top pt-3 mt-4">
            <a asp-action="Index" class="btn btn-light border">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit Department
            </a>
        </div>
    </div>
</div>