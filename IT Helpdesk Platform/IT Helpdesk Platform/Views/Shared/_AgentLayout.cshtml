@using Microsoft.AspNetCore.Identity
@using IT_Helpdesk_Platform.Models
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Agent Helpdesk</title>
    
    <link rel="icon" type="image/svg+xml" href="~/images/headset_agent.svg" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css">

    <style>
            .default-avatar-svg {
                filter: brightness(0) invert(0.9);
                width: 24px;
                height: 24px;
            }

            .user-profile-pic {
                width: 24px;
                height: 24px;
                object-fit: cover;
                border: 1px solid rgba(255,255,255,0.2);
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

            var currentUser = await UserManager.GetUserAsync(User);
            var fullName = currentUser != null ? $"{currentUser.FirstName} {currentUser.LastName}" : "Agent";

            bool hasProfilePic = false;
            if (!string.IsNullOrEmpty(currentUser?.ProfilePicturePath))
            {
                var physicalPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", currentUser.ProfilePicturePath.TrimStart('/'));
                if (System.IO.File.Exists(physicalPath))
                {
                    hasProfilePic = true;
                }
            }
            var profilePicUrl = hasProfilePic ? currentUser?.ProfilePicturePath : Url.Content("~/images/person-circle.svg");
        }
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="AgentDashboard" style="color: #198754 !important;">
                    <i class="bi bi-headset"></i> IT Helpdesk
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(currentController == "Home" && currentAction == "AgentDashboard" ? "active-page" : "")" asp-controller="Home" asp-action="AgentDashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(currentController == "Tickets" && (currentAction == "MyTickets" || currentAction == "AllTickets" || currentAction == "ViewTicket") ? "active-page" : "")"
                                   asp-controller="Tickets" asp-action="AllTickets">
                                <i class="bi bi-ticket-detailed me-1"></i> Tickets
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(currentController == "KnowledgeBase" ? "active-page" : "")" asp-controller="KnowledgeBase" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Knowledge Base
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        
                        <li class="nav-item me-3">
                            <button class="btn btn-sm btn-outline-light" id="darkModeToggle" title="Toggle Dark Mode">
                                <i class="bi bi-moon-fill" id="themeIcon"></i>
                            </button>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link custom-nav-link dropdown-toggle d-flex align-items-center @(currentController == "Account" ? "active-page" : "")"
                                   href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                
                                @if (hasProfilePic)
                                {
                                    <img src="@profilePicUrl" alt="Profile" class="rounded-circle me-2 user-profile-pic" />
                                }
                                else
                                {
                                    <img src="@profilePicUrl" alt="Default Profile" class="rounded-circle me-2 default-avatar-svg" />
                                }

                                Hello, @fullName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow slim-dropdown" aria-labelledby="accountDropdown">
                                <li>
                                    <a class="dropdown-item @(currentAction == "Profile" ? "fw-bold text-primary" : "")"
                                           asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i> Profile
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0" onsubmit="return confirm('Are you sure you want to sign out?');">
                                        <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;">
            <div class="toast align-items-center text-muted bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 IT Helpdesk Platform. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>