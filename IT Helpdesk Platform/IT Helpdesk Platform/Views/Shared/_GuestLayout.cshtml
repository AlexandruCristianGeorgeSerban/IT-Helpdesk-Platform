<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Helpdesk Platform</title>
    
    <link rel="icon" type="image/svg+xml" href="~/images/headset_guest.svg" />
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.css">

    <style>
            .default-avatar-svg {
                filter: brightness(0) invert(0.9);
                width: 24px;
                height: 24px;
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        }
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="GuestDashboard" style="color: #6c757d !important;">
                    <i class="bi bi-headset"></i> IT Helpdesk
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto gap-2">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(currentController == "Home" && currentAction == "GuestDashboard" ? "active-page" : "")" asp-controller="Home" asp-action="GuestDashboard">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link @(currentController == "KnowledgeBase" ? "active-page" : "")" asp-controller="KnowledgeBase" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Knowledge Base
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
    
                        <li class="nav-item me-3">
                            <button class="btn btn-sm btn-outline-light" id="darkModeToggle" title="Toggle Dark Mode">
                                <i class="bi bi-moon-fill" id="themeIcon"></i>
                            </button>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link d-flex align-items-center @(currentController == "Account" ? "active-page-guest" : "")" asp-controller="Account" asp-action="Login">
                                <img src="~/images/person-circle.svg" alt="Guest" class="rounded-circle me-2 default-avatar-svg" />
                                Sign In
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; 2026 IT Helpdesk Platform. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>