@model IEnumerable<IT_Helpdesk_Platform.Models.KnowledgeArticle>

@{
    ViewData["Title"] = "Knowledge Articles Management";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-journals me-2"></i>Knowledge Articles</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-journal-plus me-1"></i> Add New Article</a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentSearch"]" class="form-control border-start-0 shadow-none" placeholder="Search by ID, Title or Content..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <select name="categoryFilter" class="form-select shadow-none">
                        <option value="">All Categories</option>
                        <option value="Hardware" selected="@(ViewData["CategoryFilter"]?.ToString() == "Hardware")">Hardware & Gear</option>
                        <option value="Software" selected="@(ViewData["CategoryFilter"]?.ToString() == "Software")">Software & Accounts</option>
                        <option value="Network" selected="@(ViewData["CategoryFilter"]?.ToString() == "Network")">Network & Security</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Filter</button>
                    @if (ViewData["CurrentSearch"] != null || ViewData["CategoryFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-light rounded-pill px-3">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="content-card table-shadow p-4 bg-white rounded table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 35%;">Title</th>
                    <th style="width: 20%;">Category</th>
                    <th style="width: 20%;">Design Info</th>
                    <th class="text-end" style="width: 20%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@item.Id</td>
                        <td class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>
                            @{
                                string badgeClass = item.Category switch
                                {
                                    "Hardware" => "bg-primary",
                                    "Gear" => "bg-info",
                                    "Software" => "bg-warning",
                                    "Accounts" => "bg-purple",
                                    "Network" => "bg-success",
                                    "Security" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass shadow-sm">@item.Category</span>
                        </td>
                        <td>
                            <span class="@item.ColorClass fw-bold"><i class="bi @item.IconClass me-1"></i> @item.IconClass</span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success shadow-sm" title="Details">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted mb-0">No articles found matching your criteria.</p>
            </div>
        }
    </div>
</div>

<partial name="_BackToTop" />