@model IT_Helpdesk_Platform.Models.KnowledgeArticle

@{
    ViewData["Title"] = "Create Article";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <h2 class="mb-4"><i class="bi bi-journal-plus me-2"></i>Create New Article</h2>
    
    <div class="row">
        <div class="col-md-10">
            <div class="content-card shadow-sm p-4 bg-white rounded">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-bold">Article Title</label>
                        <input asp-for="Title" class="form-control" placeholder="E.g., How to reset a password..." />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label fw-bold">Category</label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select...</option>
                                <option value="Hardware">Hardware</option>
                                <option value="Gear">Gear</option>
                                <option value="Software">Software</option>
                                <option value="Accounts">Accounts</option>
                                <option value="Network">Network</option>
                                <option value="Security">Security</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="IconClass" class="form-label fw-bold">Icon</label>
                            <select asp-for="IconClass" class="form-select">
                                <option value="bi-pc-display">💻 PC Display</option>
                                <option value="bi-window-stack">🗔 Software</option>
                                <option value="bi-shield-check">🛡️ Security / Network</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ColorClass" class="form-label fw-bold">Color Theme</label>
                            <select asp-for="ColorClass" class="form-select">
                                <option value="text-primary">Blue (Primary)</option>
                                <option value="text-warning">Yellow (Warning)</option>
                                <option value="text-success">Green (Success)</option>
                                <option value="text-danger">Red (Danger)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-bold">Article Content (HTML allowed)</label>
                        <textarea asp-for="Content" class="form-control" rows="8" placeholder="<p>Write your detailed guide here...</p>"></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-flex justify-content-between border-top pt-3">
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i> Back to List
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Create Article
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}