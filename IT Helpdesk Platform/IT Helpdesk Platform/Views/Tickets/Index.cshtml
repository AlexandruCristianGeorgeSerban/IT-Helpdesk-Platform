@model IEnumerable<IT_Helpdesk_Platform.Models.Ticket>

@{
    ViewData["Title"] = "Tickets Management";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ticket-detailed me-2"></i>Tickets</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-ticket-detailed-fill me-1"></i> Add New Ticket</a>
    </div>

    <div class="content-card table-shadow p-4 bg-white rounded">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Ticket</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Requester</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Title)</div>
                            <div class="small text-muted">@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td>@item.Category?.Name</td>
                        <td>
                            @{
                                string statusBadge = item.Status == "Resolved" ? "bg-success" :
                                                    (item.Status == "In Progress" ? "bg-warning text-dark" :
                                                    (item.Status == "Closed" ? "bg-secondary" : "bg-primary"));
                            }
                            <span class="badge @statusBadge shadow-sm">@item.Status</span>
                        </td>
                        <td>
                            @{
                                string prioBadge = item.Priority == "High" ? "bg-danger" :
                                                  (item.Priority == "Medium" ? "bg-info text-dark" :
                                                  (item.Priority == "Critical" ? "bg-dark" : "bg-secondary"));
                            }
                            <span class="badge @prioBadge shadow-sm">@item.Priority</span>
                        </td>
                        <td>@item.Requester?.Email</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success shadow-sm" title="Details">
                                    <i class="bi bi-info-circle"></i> Details
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>