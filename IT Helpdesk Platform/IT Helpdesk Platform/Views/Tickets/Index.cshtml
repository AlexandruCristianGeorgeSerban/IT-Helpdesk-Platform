@model IEnumerable<IT_Helpdesk_Platform.Models.Ticket>

@{
    ViewData["Title"] = "Tickets Management";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ticket-detailed me-2"></i>Tickets Management</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-ticket-detailed-fill me-1"></i> Add New Ticket</a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 shadow-none" placeholder="Search by ID, Title, or Description..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="statusFilter" class="form-select shadow-none">
                        <option value="All">All Statuses</option>
                        <option value="Open" selected="@(ViewData["StatusFilter"]?.ToString() == "Open")">Open</option>
                        <option value="In Progress" selected="@(ViewData["StatusFilter"]?.ToString() == "In Progress")">In Progress</option>
                        <option value="Resolved" selected="@(ViewData["StatusFilter"]?.ToString() == "Resolved")">Resolved</option>
                        <option value="Closed" selected="@(ViewData["StatusFilter"]?.ToString() == "Closed")">Closed</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="priorityFilter" class="form-select shadow-none">
                        <option value="All">All Priorities</option>
                        <option value="Low" selected="@(ViewData["PriorityFilter"]?.ToString() == "Low")">Low</option>
                        <option value="Medium" selected="@(ViewData["PriorityFilter"]?.ToString() == "Medium")">Medium</option>
                        <option value="High" selected="@(ViewData["PriorityFilter"]?.ToString() == "High")">High</option>
                        <option value="Critical" selected="@(ViewData["PriorityFilter"]?.ToString() == "Critical")">Critical</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Filter</button>
                    @if (ViewData["CurrentFilter"] != null || ViewData["StatusFilter"] != null || ViewData["PriorityFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-light rounded-pill px-3">Clear</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="content-card table-shadow p-4 bg-white rounded">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th style="width: 25%;">Ticket Info</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Requester</th>
                    <th>Agent</th>
                    <th>Due Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@item.Id</td>
                        <td>
                            <div class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.Title)</div>
                            <div class="small text-muted"><i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                        </td>
                        <td>@item.Category?.Name</td>
                        <td>
                            @{
                                string statusBadge = item.Status switch
                                {
                                    "Open" => "bg-primary",
                                    "In Progress" => "bg-warning",
                                    "Resolved" => "bg-success",
                                    "Closed" => "bg-secondary",
                                    _ => "bg-primary"
                                };
                            }
                            <span class="badge @statusBadge shadow-sm">@item.Status</span>
                        </td>
                        <td>
                            @{
                                string prioBadge = item.Priority switch
                                {
                                    "Low" => "bg-secondary",
                                    "Medium" => "bg-info",
                                    "High" => "bg-danger",
                                    "Critical" => "bg-critical",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @prioBadge shadow-sm">@item.Priority</span>
                        </td>
                        <td>@item.Requester?.Email</td>
                        
                        <td>
                            @if (item.AssignedAgent != null)
                            {
                                <span class="text-success"><i class="bi bi-person-check-fill me-1"></i>@item.AssignedAgent.FirstName</span>
                            }
                            else
                            {
                                <span class="text-muted small"><i>Unassigned</i></span>
                            }
                        </td>
                        
                        <td>
                            @if (item.DueDate.HasValue)
                            {
                                <span class="@(item.DueDate.Value < DateTime.Now && item.Status != "Closed" && item.Status != "Resolved" ? "text-danger fw-bold" : "text-muted")">
                                    @item.DueDate.Value.ToString("MMM dd")
                                </span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success shadow-sm" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2 mb-0">No tickets found matching your criteria.</p>
            </div>
        }
    </div>
</div>

<partial name="_BackToTop" />