@model IT_Helpdesk_Platform.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-info-circle me-2"></i>Ticket #@Model.Id</h2>
    </div>
    
    <div class="content-card shadow-sm p-4 bg-white rounded position-relative mt-2" style="max-width: 900px;">
        
        @{
            string statusBadge = Model.Status == "Closed" ? "bg-success" : (Model.Status == "In Progress" ? "bg-info" : "bg-primary");
        }
        <span class="position-absolute top-0 end-0 translate-middle-y badge rounded-pill @statusBadge fs-6 px-4 py-2 shadow border border-white border-3" style="margin-right: 20px;">
            @Model.Status
        </span>

        <h3 class="text-primary mb-3 mt-2">@Model.Title</h3>
        <p class="fs-5 text-dark mb-4 p-3 bg-light rounded border">@Model.Description</p>

        <div class="row mt-4 border-top pt-4">
            <div class="col-md-6 mb-3">
                <h6 class="text-muted text-uppercase fw-bold mb-3">Ticket Info</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted mb-2">Category</dt>
                    <dd class="col-sm-8 fw-bold mb-2">@Model.Category?.Name</dd>

                    <dt class="col-sm-4 text-muted mb-2">Priority</dt>
                    <dd class="col-sm-8 fw-bold text-danger mb-2">@Model.Priority</dd>

                    <dt class="col-sm-4 text-muted">Created</dt>
                    <dd class="col-sm-8 fw-bold">@Model.CreatedAt.ToString("g")</dd>
                </dl>
            </div>
            <div class="col-md-6 mb-3">
                <h6 class="text-muted text-uppercase fw-bold mb-3">People</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted mb-2">Requester</dt>
                    <dd class="col-sm-8 fw-bold mb-2">@Model.Requester?.Email</dd>

                    <dt class="col-sm-4 text-muted">Assigned To</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.AssignedAgent?.Email ?? "Unassigned")</dd>
                </dl>
            </div>
        </div>
        
        <div class="d-flex justify-content-between border-top pt-4 mt-2">
            <a asp-action="Index" class="btn btn-light border shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Ticket
            </a>
        </div>
    </div>
</div>