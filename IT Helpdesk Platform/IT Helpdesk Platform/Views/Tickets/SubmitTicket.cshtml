@model IT_Helpdesk_Platform.Models.SubmitTicketViewModel

@{
    ViewData["Title"] = "Submit New Ticket";
}

<div class="container main-container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="content-card">
                <h3 class="mb-4"><i class="bi bi-ticket-detailed-fill me-2"></i>Submit a New Ticket</h3>
                
                <form asp-action="SubmitTicket" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Issue Title</label>
                        <input asp-for="Title" class="form-control" placeholder="E.g., Cannot connect to the 2nd floor printer">
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryList">
                                  <option selected disabled value="">Select category...</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label fw-bold">Priority Level</label>
                            <select asp-for="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Critical">Critical</option>
                            </select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Detailed Description</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Please provide as many details as possible..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>

                        <!-- Live Self-Service KB Recommendations (TF-IDF & Cosine Similarity) -->
                        <div id="kbSuggestionsContainer" class="mt-3 d-none">
                            <div class="card border-info shadow-sm bg-light-subtle">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="bi bi-journal-text text-primary fs-5 me-2"></i>
                                        <h6 class="card-title text-primary fw-bold mb-0">Recommended Knowledge Base Solutions</h6>
                                    </div>
                                    <p class="small text-muted mb-2">We found articles matching your issue. Reading them might resolve your problem instantly without submitting a ticket:</p>
                                    <div id="kbSuggestionsList" class="list-group list-group-flush rounded border"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Screenshots / Attachments (Optional)</label>
                        <input class="form-control" type="file" name="Attachments" accept="image/*" multiple>
                        <div class="form-text">You can upload multiple images (JPG, PNG).</div>
                    </div>

                    <div class="d-flex justify-content-end border-top pt-3">
                        <a asp-action="MyTickets" class="btn btn-light me-2">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i> Submit Ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Quick Viewing KB Article Solution -->
<div class="modal fade" id="kbModal" tabindex="-1" aria-labelledby="kbModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="kbModalLabel">
                    <i class="bi bi-book-half text-primary me-2"></i><span id="kbModalTitle"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <span id="kbModalCategory" class="badge bg-secondary mb-3"></span>
                <div id="kbModalContent" style="white-space: pre-wrap;" class="p-3 bg-light rounded border text-secondary"></div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <a asp-action="MyTickets" class="btn btn-outline-success">
                    <i class="bi bi-check-circle-fill me-1"></i> This Solved My Problem (Cancel Ticket)
                </a>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    Continue Submitting Ticket
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let kbDebounceTimer = null;
        let currentSuggestions = [];

        function getCategoryBadgeClass(category) {
            const cat = (category || '').toLowerCase();
            if (cat.includes('hard') || cat.includes('gear') || cat.includes('device')) {
                return 'bg-primary-subtle text-primary border-primary-subtle';
            }
            if (cat.includes('soft') || cat.includes('app')) {
                return 'bg-info-subtle text-info border-info-subtle';
            }
            if (cat.includes('net') || cat.includes('wifi') || cat.includes('vpn')) {
                return 'bg-warning-subtle text-warning border-warning-subtle';
            }
            if (cat.includes('access') || cat.includes('sec') || cat.includes('pass')) {
                return 'bg-danger-subtle text-danger border-danger-subtle';
            }
            return 'bg-secondary-subtle text-secondary border-secondary-subtle';
        }

        function fetchKbSuggestions() {
            const title = $('#Title').val().trim();
            const desc = $('#Description').val().trim();
            const query = (title + " " + desc).trim();

            if (query.length < 4) {
                $('#kbSuggestionsContainer').addClass('d-none');
                $('#kbSuggestionsList').empty();
                return;
            }

            $.ajax({
                url: '/Tickets/GetKbSuggestions',
                type: 'GET',
                data: { query: query },
                success: function (data) {
                    currentSuggestions = data || [];
                    const $list = $('#kbSuggestionsList');
                    $list.empty();

                    if (currentSuggestions.length > 0) {
                        currentSuggestions.forEach(function (item, index) {
                            const catBadgeClass = getCategoryBadgeClass(item.category);
                            const matchBadgeClass = item.similarity >= 40
                                ? 'bg-success-subtle text-success border border-success-subtle'
                                : 'bg-info-subtle text-info border border-info-subtle';

                            const itemHtml = `
                                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                                    <div>
                                        <div class="fw-bold text-dark mb-1">${item.title}</div>
                                        <span class="badge ${catBadgeClass} border me-2">${item.category}</span>
                                        <span class="badge ${matchBadgeClass} rounded-pill">${item.similarity}% match</span>
                                    </div>
                                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="showKbArticleModal(${index})">
                                        <i class="bi bi-eye me-1"></i> Read Article
                                    </button>
                                </div>`;
                            $list.append(itemHtml);
                        });
                        $('#kbSuggestionsContainer').removeClass('d-none');
                    } else {
                        $('#kbSuggestionsContainer').addClass('d-none');
                    }
                },
                error: function () {
                    $('#kbSuggestionsContainer').addClass('d-none');
                }
            });
        }

        function showKbArticleModal(index) {
            const article = currentSuggestions[index];
            if (!article) return;
            $('#kbModalTitle').text(article.title);
            $('#kbModalCategory').text('Category: ' + article.category);
            $('#kbModalContent').text(article.content);
            const modal = new bootstrap.Modal(document.getElementById('kbModal'));
            modal.show();
        }

        $(document).ready(function () {
            $('#Title, #Description').on('input keyup', function () {
                clearTimeout(kbDebounceTimer);
                kbDebounceTimer = setTimeout(fetchKbSuggestions, 350);
            });
        });
    </script>
}