@model IEnumerable<IT_Helpdesk_Platform.Models.Ticket>

@{
    ViewData["Title"] = "My Tickets";
}

<div class="container main-container">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ticket-detailed me-2"></i>My Tickets</h2>
        <a asp-action="SubmitTicket" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Ticket
        </a>
    </div>

    <div class="content-card">
        
        <form asp-action="MyTickets" method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-2 mb-2">
                    <select name="statusFilter" class="form-select shadow-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewData["StatusFilter"]?.ToString() == "All" || string.IsNullOrEmpty(ViewData["StatusFilter"]?.ToString()))">All Statuses</option>
                        <option value="Open" selected="@(ViewData["StatusFilter"]?.ToString() == "Open")">Open</option>
                        <option value="In Progress" selected="@(ViewData["StatusFilter"]?.ToString() == "In Progress")">In Progress</option>
                        <option value="Resolved" selected="@(ViewData["StatusFilter"]?.ToString() == "Resolved")">Resolved</option>
                        <option value="Closed" selected="@(ViewData["StatusFilter"]?.ToString() == "Closed")">Closed</option>
                    </select>
                </div>
                
                <div class="col-md-2 mb-2">
                    <select name="priorityFilter" class="form-select shadow-sm" onchange="this.form.submit()">
                        <option value="All" selected="@(ViewData["PriorityFilter"]?.ToString() == "All" || string.IsNullOrEmpty(ViewData["PriorityFilter"]?.ToString()))">All Priorities</option>
                        <option value="Critical" selected="@(ViewData["PriorityFilter"]?.ToString() == "Critical")">Critical</option>
                        <option value="High" selected="@(ViewData["PriorityFilter"]?.ToString() == "High")">High</option>
                        <option value="Medium" selected="@(ViewData["PriorityFilter"]?.ToString() == "Medium")">Medium</option>
                        <option value="Low" selected="@(ViewData["PriorityFilter"]?.ToString() == "Low")">Low</option>
                    </select>
                </div>
                
                <div class="col-md-8 mb-2">
                    <div class="input-group shadow-sm">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by ID, Title, or Description...">
                        
                        <button class="btn btn-primary px-4" type="submit">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        
                        <a asp-action="MyTickets" class="btn btn-outline-danger px-3" title="Clear Filters" style="border-left: none;">
                            <i class="bi bi-x-circle me-1"></i> Clear
                        </a>
                    </div>
                </div>
                
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">ID</th>
                        <th style="width: 25%;">Title</th>
                        <th style="width: 15%;">Requester</th>
                        <th style="width: 15%;">SLA Deadline</th>
                        <th style="width: 10%;">Priority</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 12%;">Created On</th>
                        <th style="width: 8%;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@item.Title</td>
                            
                            <td>@(item.Requester != null ? $"{item.Requester.FirstName} {item.Requester.LastName}" : "Unknown")</td>
                            
                            <td>
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event"></i>
                                    @(item.DueDate.HasValue? item.DueDate.Value.ToString("dd MMM, HH:mm") : "N/A")
                                </small>

                                @if (item.DueDate.HasValue && item.Status != "Resolved" && item.Status != "Closed")
                                {
                                    if (item.DueDate < DateTime.Now)
                                    {
                                        <br />
                                        <span class="badge bg-danger shadow-sm mt-1">
                                            <i class="bi bi-exclamation-triangle-fill"></i> SLA Breached
                                        </span>
                                    }
                                    else if (item.DueDate < DateTime.Now.AddHours(2))
                                    {
                                        <br />
                                        <span class="badge bg-warning shadow-sm mt-1">
                                            <i class="bi bi-clock-history"></i> Approaching SLA
                                        </span>
                                    }
                                }
                            </td>

                            <td>
                                @{
                                    var priorityClass = item.Priority switch
                                    {
                                        "Low" => "bg-secondary",
                                        "Medium" => "bg-info",
                                        "High" => "bg-danger",
                                        "Critical" => "bg-critical",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @priorityClass">@item.Priority</span>
                            </td>
                            
                            <td>
                                @{
                                    var statusClass = item.Status switch
                                    {
                                        "Open" => "bg-primary",
                                        "In Progress" => "bg-warning",
                                        "Resolved" => "bg-success",
                                        "Closed" => "bg-secondary",
                                        _ => "bg-primary"
                                    };
                                }
                                <span class="badge @statusClass">@item.Status</span>
                            </td>
                            
                            <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <a asp-action="ViewTicket" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
    </div>
</div>

<partial name="_BackToTop" />