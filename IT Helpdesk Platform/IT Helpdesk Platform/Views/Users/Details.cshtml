@model IT_Helpdesk_Platform.Models.User

@{
    ViewData["Title"] = "User Details";
}

<div class="container main-container mt-4">
    <h2 class="mb-4"><i class="bi bi-person-vcard me-2"></i>User Details</h2>
    
    <div class="content-card shadow-sm p-4 bg-white rounded" style="max-width: 800px;">
        <div class="row mb-4">
            <div class="col-md-2 text-center">
                <i class="bi bi-person-circle text-secondary" style="font-size: 4rem;"></i>
            </div>
            <div class="col-md-10 d-flex flex-column justify-content-center">
                <h3 class="mb-0">@Model.FirstName @Model.LastName</h3>
                <p class="text-muted fs-5">@Model.Role</p>
            </div>
        </div>

        <dl class="row mb-0 bg-light p-3 rounded border">
            <dt class="col-sm-4 text-muted">Email Address</dt>
            <dd class="col-sm-8 fw-bold">@Model.Email</dd>
            
            <dt class="col-sm-4 text-muted">Department</dt>
            <dd class="col-sm-8 fw-bold">@Model.Department?.Name</dd>
        </dl>
        
        <div class="d-flex justify-content-between border-top pt-3 mt-4">
            <a asp-action="Index" class="btn btn-light border">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit User
            </a>
        </div>
    </div>
</div>