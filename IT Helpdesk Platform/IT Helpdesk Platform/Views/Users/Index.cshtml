@model IEnumerable<IT_Helpdesk_Platform.Models.User>

@{
    ViewData["Title"] = "Users Management";

    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<div class="container main-container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people me-2"></i>Users Management</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i> Add New User</a>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex align-items-center">
                <i class="bi bi-search fs-5 text-muted me-3"></i>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 shadow-none" placeholder="Search by ID, Name, or Email..." />
                <button type="submit" class="btn btn-primary ms-3 rounded-pill px-4">Search</button>
                @if (ViewData["CurrentFilter"] != null)
                {
                    <a asp-action="Index" class="btn btn-light ms-2 rounded-pill px-4">Clear</a>
                }
            </form>
        </div>
    </div>

    <div class="content-card table-shadow p-4 bg-white rounded table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width: 5%;">ID</th>
                    <th>Name</th>
                    <th>Contact Info</th>
                    <th>@Html.DisplayNameFor(model => model.Role)</th>
                    <th>Department</th>
                    <th>Alerts</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted fw-bold">#@item.Id</td>
                        <td class="fw-bold text-primary">
                            @Html.DisplayFor(modelItem => item.FirstName) @Html.DisplayFor(modelItem => item.LastName)
                        </td>
                        <td>
                            <div><i class="bi bi-envelope text-muted me-1"></i>@Html.DisplayFor(modelItem => item.Email)</div>
                            @if (!string.IsNullOrEmpty(item.PhoneNumber))
                            {
                                <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.PhoneNumber</div>
                            }
                        </td>
                        <td>
                            @{
                                string badgeColor = "bg-secondary";
                                if (item.Role == "Admin") badgeColor = "bg-danger";
                                else if (item.Role == "Agent") badgeColor = "bg-success";
                                else if (item.Role == "User") badgeColor = "bg-primary";
                            }
                            <span class="badge @badgeColor shadow-sm">@item.Role</span>
                        </td>
                        <td>@item.Department?.Name</td>
                        <td>
                            @if (item.EmailNotificationsEnabled)
                            {
                                <i class="bi bi-envelope-check-fill text-success" title="Email Alerts Enabled"></i>
                            }
                            @if (item.PushNotificationsEnabled)
                            {
                                <i class="bi bi-bell-fill text-primary ms-1" title="Push Alerts Enabled"></i>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary shadow-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success shadow-sm" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="text-center py-4">
                <p class="text-muted mb-0">No users found matching your search.</p>
            </div>
        }
    </div>
</div>

<partial name="_BackToTop" />